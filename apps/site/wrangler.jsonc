{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "min7-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // Created on deploy. The ayagmar.dev zone must be on the same Cloudflare account.
  "routes": [{ "pattern": "ayagmar.dev", "custom_domain": true }],
  "assets": {
    // Built by `just site-build`: Astro, then Pagefind, then scripts/postbuild.ts.
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker sees only the pages with a text or Markdown copy, to answer terminal clients and
    // agents with it (ADR 0040); never their subresources, feeds or the copies themselves.
    "run_worker_first": [
      "/",
      "/now",
      "/about",
      "/uses",
      "/stats",
      "/writing",
      "/writing/*",
      "/til",
      "/til/*",
      "/projects",
      "/projects/*",
      "!/writing/tags/*",
      "!/*.md",
      "!/*.txt",
      "!/*.xml"
    ]
  },
  // Required by `wrangler preview` even though the site has no bindings to swap.
  "previews": {}
}
