---
import Freshness from '../components/Freshness.astro';
import NowPlaying from '../components/NowPlaying.astro';
import ShippingList from '../components/ShippingList.astro';
import Stamp from '../components/Stamp.astro';
import { count, projectsSummary, repoName } from '../data/format.ts';
import { emptyEnvelope } from '../data/reader.ts';
import { liveAttrs, signals, signalsApiBase, signalsMode } from '../data/signals.ts';
import Base from '../layouts/Base.astro';
import { dayName } from '../lib/history.ts';
import { site } from '../lib/site.ts';
import { starTotals, weekCount, statsWords as words } from '../lib/stats.ts';

const listening = await signals.read('listening');
const shipping = await signals.read('shipping');
const projects = await signals.read('projects');
// Shelf: not wired yet, shown empty until its contract lands. LLM usage shows only its
// agent hours so far, read by the browser (ADR 0015).
const shelf = emptyEnvelope('shelf');

const music = listening.data;
const stars = shipping.data === null ? [] : starTotals(shipping.data);
---

<Base title="Stats">
  <h1>Stats</h1>
  {signalsMode === 'fixtures' ? (
    <p class="sample sample-banner">
      Sample data: this build shows the test fixtures, some of them made up. The live numbers are on{' '}
      <a href={new URL('/stats', Astro.site)}>ayagmar.dev</a>.
    </p>
  ) : (
    <p class="caption">
      Numbers from my own tools, kept current by your browser while this page is open. On this day
      and agent hours show only on the date in Rabat they describe.
    </p>
  )}

  <div class="stats-grid">
    {/* src/scripts/stats-live.ts replaces each panel's build-time snapshot with a newer live one. */}
    <section
      class="panel m-vinyl"
      aria-labelledby="listening"
      {...liveAttrs('listening', listening)}
    >
      <h2 id="listening">Listening</h2>
      <NowPlaying listening={listening} />
      <div class="listening-body">
        {music !== null && (
          <>
            <dl>
              <dt>{words.thisWeek}</dt>
              <dd>{weekCount(music.scrobbles.thisWeek)}</dd>
              <dt>{words.lastWeek}</dt>
              <dd>{weekCount(music.scrobbles.lastWeek)}</dd>
            </dl>
            <h3>{words.recent}</h3>
            {music.recent.length === 0 ? (
              <p>{words.noRecent}</p>
            ) : (
              <ol>
                {music.recent.map((track) => (
                  <li>
                    <cite>{track.track}</cite> by {track.artist}, <Stamp iso={track.playedAt} />
                  </li>
                ))}
              </ol>
            )}
            <h3>{words.top}</h3>
            {music.topArtists === null || music.topArtists.length === 0 ? (
              <p>{words.noTop}</p>
            ) : (
              <ol>
                {music.topArtists.map((artist) => (
                  <li>
                    {artist.artist}, {count(artist.plays)} plays
                  </li>
                ))}
              </ol>
            )}
          </>
        )}
      </div>
      <p>
        <a href={site.links.lastfm}>All of it on Last.fm</a>
      </p>
      <Freshness envelope={listening} />
      {/* Filled in, and shown, by src/scripts/history.ts (ADR 0030); hidden without it. */}
      <div
        class="history"
        data-history-src={signalsMode === 'api'
          ? `${signalsApiBase}/v1/listening-history`
          : undefined}
        hidden
      >
        <h3>On this day</h3>
        <p>On <span class="history-date"></span> in past years:</p>
        <ol></ol>
        <p class="history-empty" hidden>Nothing played on this date in any past year.</p>
      </div>
    </section>

    <section class="panel m-cork" aria-labelledby="shipping" {...liveAttrs('shipping', shipping)}>
      <h2 id="shipping">Shipping</h2>
      <div class="shipping-body">
        {shipping.data === null || shipping.data.events.length === 0 ? (
          <p>{words.noShipping}</p>
        ) : (
          <ShippingList events={shipping.data.events.slice(0, 15)} />
        )}
        {stars.length > 0 && (
          <>
            <h3>{words.stars}</h3>
            <ul>
              {stars.map((entry) => (
                <li>
                  {repoName(entry.repo)}: {count(entry.stars)} on{' '}
                  <time datetime={entry.date}>{dayName(entry.date)}</time>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
      <Freshness envelope={shipping} />
    </section>

    <section class="panel m-screen" aria-labelledby="projects" {...liveAttrs('projects', projects)}>
      <h2 id="projects">Projects</h2>
      <div class="projects-body">
        {projects.data === null ? (
          <p>{words.noProjects}</p>
        ) : (
          <p>
            {projectsSummary(projects.data.projects)} <a href="/projects">See them</a>.
          </p>
        )}
      </div>
      <Freshness envelope={projects} />
    </section>

    <section class="panel m-frame" aria-labelledby="llm-usage">
      <h2 id="llm-usage">LLM usage</h2>
      <p class="llm-usage-empty">No data yet.</p>
      {/* Filled in, and shown, by src/scripts/agent-hours.ts (ADR 0014); hidden without it. */}
      <div
        class="agent-hours"
        data-llm-usage-src={signalsMode === 'api' ? `${signalsApiBase}/v1/llm-usage` : undefined}
        hidden
      >
        <h3>Estimated agent hours</h3>
        <dl>
          <div class="agent-hours-month">
            <dt>This month so far</dt>
            <dd></dd>
          </div>
          <div class="agent-hours-week">
            <dt>Last 7 days</dt>
            <dd></dd>
          </div>
        </dl>
        <p>
          Estimated from logged agent events with gaps capped at 5 minutes; overlapping sessions and
          machines count once. Includes overnight agents and laptop usage, not my hours at the
          keyboard.
        </p>
        <p class="freshness agent-hours-as-of"></p>
      </div>
    </section>

    <section class="panel m-wood" aria-labelledby="shelf">
      <h2 id="shelf">Shelf</h2>
      <p>No data yet.</p>
      <Freshness envelope={shelf} />
    </section>
  </div>
</Base>

<script>
import '../scripts/history.ts';
import '../scripts/agent-hours.ts';
import '../scripts/stats-live.ts';
</script>
