---
import { featuredProjects } from '@min7/contracts';
import Freshness from '../components/Freshness.astro';
import Markup from '../components/Markup.astro';
import NowPlaying from '../components/NowPlaying.astro';
import ShippingHeat from '../components/ShippingHeat.astro';
import { shippingStrip } from '../data/format.ts';
import { liveAttrs, signals, signalsApiBase, signalsMode } from '../data/signals.ts';
import Base from '../layouts/Base.astro';
import { listeningBody } from '../lib/listening-panel.ts';
import { llmUsagePanel } from '../lib/llm-usage-panel.ts';
import { getDays } from '../lib/posts.ts';
import { site } from '../lib/site.ts';
import { statsWords as words } from '../lib/stats.ts';
import { projectsBody, shippingBody, typingBody } from '../lib/stats-panels.ts';
import { typingWords } from '../lib/typing.ts';

const listening = await signals.read('listening');
const shipping = await signals.read('shipping');
// Drawn once, with the page (ADR 0038); the live script redraws only the list under it.
const strip = shippingStrip(
  await signals.readDays('shipping-activity'),
  shipping,
  new Date(),
  (await getDays()).dates
);
const projects = await signals.read('projects');
const typing = await signals.read('monkeytype');
const llmUsage = await signals.read('llm-usage');
// The site does not read the shelf (trellis, /v1/shelf, ADR 0013) yet, so it has no panel: an
// empty box said nothing. The panel comes back when the site reads it.

const music = listening.data;
// The projects window counts these repositories' stars; shipping's star list leaves them out,
// in the build and in the live script, which reads them from data-featured.
const featured = featuredProjects.map((project) => project.repo);
---

<Base
  title="Stats"
  description="Live numbers from Abdeslam Yassine Agmar's week: listening, projects, typing, shipping and LLM usage."
>
  {/* Its scripts read the API as the page loads; in fixtures mode they make no request. */}
  {signalsMode === 'api' && <link slot="head" rel="preconnect" href={signalsApiBase} crossorigin>}
  <h1>Stats</h1>
  {signalsMode === 'fixtures' ? (
    <p class="sample sample-banner">
      Sample data: this build shows the test fixtures, some of them made up. The live numbers are on{' '}
      <a href={new URL('/stats', Astro.site)}>ayagmar.dev</a>.
    </p>
  ) : (
    <p class="caption">
      Numbers from my own tools, kept current by your browser while this page is open. On this day
      and this month's LLM usage show only on the date in Rabat they describe.
    </p>
  )}

  {/* Two columns from 60rem, each a stack, so a tall panel never leaves a hole beside it. On a
      phone they read one after the other. src/scripts/stats-live.ts replaces each panel's
      build-time snapshot with a newer live one. */}
  <div class="stats-grid">
    <div class="stats-col">
      <section
        class="panel m-vinyl"
        aria-labelledby="listening"
        {...liveAttrs('listening', listening)}
      >
        <h2 id="listening">Listening</h2>
        <NowPlaying listening={listening} />
        <div class="listening-body">
          {music !== null && <Markup nodes={listeningBody(music)} />}
        </div>
        <p>
          <a href={site.links.lastfm}>All of it on Last.fm</a>
        </p>
        <Freshness envelope={listening} />
        {/* Filled in, and shown, by src/scripts/history.ts (ADR 0030); hidden without it. */}
        <div
          class="history"
          data-history-src={signalsMode === 'api'
            ? `${signalsApiBase}/v1/listening-history`
            : undefined}
          hidden
        >
          <h3>On this day</h3>
          <p>On <span class="history-date"></span> in past years:</p>
          <ol></ol>
          <p class="history-empty" hidden>Nothing played on this date in any past year.</p>
        </div>
      </section>

      <section
        class="panel m-screen"
        aria-labelledby="projects"
        {...liveAttrs('projects', projects)}
      >
        <h2 id="projects">Projects</h2>
        <div class="projects-body">
          {projects.data === null ? (
            <p>{words.noProjects}</p>
          ) : (
            <Markup nodes={projectsBody(projects.data)} />
          )}
        </div>
        <Freshness envelope={projects} />
      </section>

      <section class="panel m-tea" aria-labelledby="typing" {...liveAttrs('monkeytype', typing)}>
        <h2 id="typing">Typing</h2>
        {/* The day each best was set; src/scripts/stats-live.ts reads it relative to now. */}
        <div class="typing-body">
          {typing.data === null ? (
            <p>{typingWords.noData}</p>
          ) : (
            <Markup nodes={typingBody(typing.data)} />
          )}
        </div>
        <Freshness envelope={typing} />
      </section>
    </div>

    <div class="stats-col">
      <section
        class="panel m-cork"
        aria-labelledby="shipping"
        data-featured={featured.join(' ')}
        {...liveAttrs('shipping', shipping)}
      >
        <h2 id="shipping">Shipping</h2>
        {/* Built once: the live script redraws only the list under it (ADR 0034). */}
        {strip !== null && <ShippingHeat strip={strip} />}
        <div class="shipping-body">
          {shipping.data === null ? (
            <p>{words.noShipping}</p>
          ) : (
            <Markup nodes={shippingBody(shipping.data, featured)} />
          )}
        </div>
        <Freshness envelope={shipping} />
      </section>

      <section
        class="panel m-frame"
        aria-labelledby="llm-usage"
        {...liveAttrs('llm-usage', llmUsage)}
      >
        <h2 id="llm-usage">LLM usage</h2>
        {/* The same markup the live script draws (src/lib/llm-usage-panel.ts, ADR 0014). */}
        <div class="llm-usage-body">
          {llmUsage.data === null || llmUsage.fetchedAt === null ? (
            <p>No data yet.</p>
          ) : (
            <Markup nodes={llmUsagePanel(llmUsage.data, llmUsage.fetchedAt)} />
          )}
        </div>
        <Freshness envelope={llmUsage} />
      </section>
    </div>
  </div>
</Base>

<script>
import '../scripts/history.ts';
import '../scripts/stats-live.ts';
</script>

<style is:global>
/* The LLM usage panel. Global, not scoped: the live script redraws its body (src/lib/llm-usage-panel.ts). */
.llm-totals {
  display: table;
  width: 100%;
  margin-block: 1rem;
}

.llm-totals th,
.llm-totals td {
  padding-inline-end: 0.6rem;
}

.llm-totals thead th {
  color: var(--fg-2);
  font-size: 0.8125rem;
  font-weight: 400;
}

.llm-range {
  display: block;
  letter-spacing: 0;
  text-transform: none;
}

.llm-totals tbody th {
  border-bottom: 1px solid color-mix(in srgb, var(--fg) 25%, transparent);
  font-weight: 500;
  white-space: nowrap;
}

.llm-totals td {
  font-family: var(--mono);
  font-size: 0.9375rem;
}

/* `144 hours` on one line wherever the table has the room: from 384px wide. */
@media (min-width: 24rem) {
  .llm-totals td {
    white-space: nowrap;
  }
}

.llm-agents {
  padding: 0;
  list-style: none;
}

/* Name, bar, tokens and share on one line; the bar takes what is left, never less than 2.5rem,
   and a long name wraps instead, at a space unless one word is wider than its column. */
.llm-agents li {
  display: grid;
  grid-template-columns: minmax(0, 7.5rem) minmax(2.5rem, 1fr) 3.5rem 2.75rem;
  gap: 0.5rem;
  align-items: center;
  font-variant-numeric: tabular-nums;
}

.llm-agent {
  overflow-wrap: break-word;
}

.llm-bar {
  width: 100%;
  height: 0.5rem;
  background: color-mix(in srgb, var(--fg) 18%, transparent);
  fill: var(--accent);
}

.llm-tokens,
.llm-share {
  text-align: end;
}

.llm-note {
  color: var(--fg-2);
  font-size: 0.875rem;
}

/* A year of days, a column a week: 4px cells and 1px gaps fit 53 weeks in 264px, the panel's
   width on a desktop. On a phone it scrolls, starting at the latest week: the scroller runs
   right to left, the cells left to right. Contained, so the year's width does not widen the
   panel. Its 371 cells cost more style and layout than the rest of the page (mobile TBT, ADR
   0017); it sits below the fold, so the browser skips that work until it is near the screen,
   holding its height meanwhile. */
.llm-heat {
  content-visibility: auto;
  contain-intrinsic-size: auto 3.4rem;
}

.llm-heat-scroll {
  overflow-x: auto;
  direction: rtl;
  contain: inline-size;
}

/* As wide as its weeks need, so the scroller can reach every one; wider cells when it fits. */
.llm-heat .heat-cells {
  width: max-content;
  min-width: 100%;
  direction: ltr;
  grid-template-columns: none;
  grid-template-rows: repeat(7, auto);
  grid-auto-columns: minmax(4px, 1fr);
  grid-auto-flow: column;
  gap: 1px;
}
</style>
