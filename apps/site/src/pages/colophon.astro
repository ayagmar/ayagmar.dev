---
import { COMMIT_SHA } from 'astro:env/server';
import Base from '../layouts/Base.astro';

const repo = 'https://github.com/ayagmar/ayagmar.dev';
const isCommit = /^[0-9a-f]{40}$/.test(COMMIT_SHA);
---

<Base title="Colophon">
  <div class="paper t-colophon">
    <h1>Colophon</h1>
    <p>
      Built with Astro and Svelte, served by Cloudflare Workers. Search by Pagefind. No tracking, no
      cookies, no third-party scripts.
    </p>
    <p>
      This build:
      {isCommit ? (
        <a href={`${repo}/commit/${COMMIT_SHA}`}>
          <code>{COMMIT_SHA.slice(0, 12)}</code>
        </a>
      ) : (
        <code>{COMMIT_SHA}</code>
      )}
    </p>
    <p>
      Set in Source Serif 4 and JetBrains Mono, with Pixelify Sans for the headings and the
      interface, all self-hosted. The room on the home page is drawn by a script, pixel by pixel; no
      photos. The rest of the site is its desktop: windows, a status bar, a little phosphor.
    </p>
    <p><a href={repo}>Source</a> (code MIT, writing all rights reserved).</p>
    <p>
      The weather in the room's window is Rabat's from
      <a href="https://open-meteo.com/">Open-Meteo</a>, under
      <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, drawn simplified.
    </p>
  </div>
</Base>
