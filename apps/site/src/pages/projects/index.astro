---
import { Image } from 'astro:assets';
import ProjectRow from '../../components/ProjectRow.astro';
import Sample from '../../components/Sample.astro';
import { liveAttrs } from '../../data/signals.ts';
import Base from '../../layouts/Base.astro';
import { imageFor } from '../../lib/content-images.ts';
import { pluginsSection, pluginUrl } from '../../lib/noctalia-plugins.ts';
import { getNoctaliaPlugins, getPosts, getProjects } from '../../lib/posts.ts';
import { projectFact } from '../../lib/project-row.ts';
import { projectsByGroup } from '../../lib/projects.ts';

const posts = await getPosts();
const { projects, envelope } = await getProjects();
// The fixtures' numbers are a sample (ADR 0015): said once, above the rows that show them.
const sample = projects.some((project) => projectFact(project.live) !== '');
const plugins = await getNoctaliaPlugins();
---

<Base
  title="Projects"
  description="Tools and Noctalia shell plugins Abdeslam Yassine Agmar builds and keeps running, with GitHub activity and the posts about them."
>
  <div class="column">
    <h1>Projects</h1>
    <p class="caption">What is on the monitor: tools I build and keep running.</p>
    {sample && <Sample />}
    <div {...liveAttrs('projects', envelope)}>
      {projectsByGroup(projects).map((group) => (
        <section class="panel m-screen" aria-labelledby={`group-${group.id}`}>
          <h2 id={`group-${group.id}`}>{group.title}</h2>
          <ul class="projects">
            {group.projects.map((project) => (
              <ProjectRow project={project} posts={posts} id={project.slug} />
            ))}
          </ul>
        </section>
      ))}
    </div>
    {plugins.length > 0 && (
      <section
        id={pluginsSection.id}
        class="panel m-screen"
        aria-labelledby={`${pluginsSection.id}-title`}
        data-pagefind-body
        data-pagefind-meta={`title:${pluginsSection.title}`}
      >
        <h2 id={`${pluginsSection.id}-title`}>{pluginsSection.title}</h2>
        <p class="caption">{pluginsSection.intro}</p>
        <ul class="projects">
          {plugins.map((plugin) => (
            <li class:list={{ 'has-thumb': plugin.thumbnail !== undefined }}>
              <h3>
                <a href={pluginUrl(plugin)}>{plugin.name}</a>
              </h3>
              <p>{plugin.summary}</p>
              {/* Its name and summary are the row's words; the thumbnail repeats them. */}
              {plugin.thumbnail !== undefined && (
                <Image
                  class="plugin-thumb"
                  src={imageFor('plugins', plugin.thumbnail.file)}
                  alt=""
                  width={160}
                  densities={[1, 2]}
                />
              )}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
