---
import Base from '../../layouts/Base.astro';
import { getPosts, getProjects } from '../../lib/posts.ts';
import { projectPath, projectRowLabel, projectsByGroup } from '../../lib/projects.ts';

const posts = await getPosts();
const { projects } = await getProjects();
---

<Base
  title="Projects"
  description="Tools Abdeslam Yassine Agmar builds and keeps running, with their GitHub activity and the posts about them."
>
  <div class="column">
    <h1>Projects</h1>
    <p class="caption">What is on the monitor: tools I build and keep running.</p>
    {projectsByGroup(projects).map((group) => (
      <section class="panel m-screen" aria-labelledby={`group-${group.id}`}>
        <h2 id={`group-${group.id}`}>{group.title}</h2>
        <ul class="projects">
          {group.projects.map((project) => (
            <li id={project.slug}>
              <h3>
                <a href={projectPath(project.slug)}>{project.slug}</a>
              </h3>
              {project.summary !== null && <p>{project.summary}</p>}
              {projectRowLabel(project, posts) !== '' && (
                <p class="project-post-count">{projectRowLabel(project, posts)}</p>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
