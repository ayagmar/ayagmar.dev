---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Freshness from '../../components/Freshness.astro';
import Markup from '../../components/Markup.astro';
import PostList from '../../components/PostList.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import ProjectShot from '../../components/ProjectShot.astro';
import ProjectStats from '../../components/ProjectStats.astro';
import { liveAttrs, signals } from '../../data/signals.ts';
import Base from '../../layouts/Base.astro';
import { projectReceipt } from '../../lib/days.ts';
import { feedPaths } from '../../lib/feed.ts';
import { getDays, getPosts, getProjectScreenshots, getProjects } from '../../lib/posts.ts';
import { projectEvents, projectLog } from '../../lib/project-panel.ts';
import { postsAbout, projectPath } from '../../lib/projects.ts';
import { site } from '../../lib/site.ts';
import { breadcrumbs } from '../../lib/structured-data.ts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const { projects, envelope } = await getProjects();
  const { history } = await getDays();
  const logs = await signals.read('project-events');
  const screenshots = await getProjectScreenshots();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: {
      project,
      envelope,
      logs,
      posts: postsAbout(posts, project.slug),
      receipt: projectReceipt(history, project.repo),
      screenshot: screenshots.get(project.slug),
    },
  }));
}) satisfies GetStaticPaths;

const { project, envelope, logs, posts, receipt, screenshot } = Astro.props;
const log = projectLog(projectEvents(logs.data, project.slug));
const { Content } =
  project.file === undefined ? { Content: undefined } : await render(project.file);
const feeds = feedPaths({ project: project.slug });
---

<Base
  title={project.slug}
  description={project.summary ?? `${project.slug}, a project by ${site.author}.`}
  feed={{ project: project.slug }}
  structuredData={[
    breadcrumbs([
      { name: 'Projects', path: '/projects' },
      { name: project.slug, path: projectPath(project.slug) },
    ]),
  ]}
>
  <article class="project column">
    <header class="panel m-screen" data-pagefind-body data-pagefind-meta={`title:${project.slug}`}>
      <h1>{project.slug}</h1>
      {project.summary !== null && <p class="project-summary">{project.summary}</p>}
      {project.status !== null && <p class="project-status">Status: {project.status}</p>}
    </header>
    {screenshot !== undefined && <ProjectShot screenshot={screenshot} />}
    {Content !== undefined && (
      <section
        class="paper project-description"
        aria-label={`About ${project.slug}`}
        data-pagefind-body
      >
        <div class="prose">
          <Content />
        </div>
      </section>
    )}
    <h2>Numbers</h2>
    <ProjectStats project={project} envelope={envelope} />
    {receipt !== null && <p class="receipt">{receipt}</p>}
    {/* Always in the page so the live script can fill it; hidden while it has nothing. */}
    <section
      class="project-log"
      aria-labelledby="shipped"
      hidden={log.length === 0}
      data-project={project.slug}
      data-pagefind-ignore
      {...liveAttrs('project-events', logs)}
    >
      <h2 id="shipped">Recently shipped</h2>
      <div class="project-log-body">
        <Markup nodes={log} />
      </div>
      <Freshness envelope={logs} />
    </section>
    <h2>Links</h2>
    <ProjectLinks project={project} />
    <h2>Writing about {project.slug}</h2>
    <PostList posts={posts} empty={`Nothing written about ${project.slug} yet.`} />
    <p>
      Follow writing about {project.slug}: <a href={feeds.rss}>RSS</a>,{' '}
      <a href={feeds.atom}>Atom</a>.
    </p>
  </article>
</Base>
