---
import NowPlayingPanel from '../components/NowPlayingPanel.astro';
import PostList from '../components/PostList.astro';
import ShippingHeat from '../components/ShippingHeat.astro';
import ShippingList from '../components/ShippingList.astro';
import { signals, signalsApiBase, signalsMode } from '../data/signals.ts';
import Base from '../layouts/Base.astro';
import { getPosts, getProjects } from '../lib/posts.ts';
import { projectPath } from '../lib/projects.ts';
import { roomObjects } from '../lib/room.ts';
import { site } from '../lib/site.ts';
import '../styles/room.css';

const posts = (await getPosts()).slice(0, 4);
const projects = (await getProjects()).projects.slice(0, 5);
const listening = await signals.read('listening');
const shipping = await signals.read('shipping');
const recentlyShipped = shipping.data?.events.slice(0, 4) ?? [];
---

<Base>
  <section slot="room" class="room" aria-label="The room">
    <!-- The weather endpoint only in api mode: fixtures mode makes no request (ADR 0029). -->
    <div
      class="scene"
      data-weather-src={signalsMode === 'api' ? `${signalsApiBase}/v1/weather` : undefined}
    >
      <span
        class="room-art night"
        role="img"
        aria-label="A pixel-art desk at night in Morocco. The lamp is on and the monitor glows; an arched window looks out over rooftops and a minaret."
      ></span>
      <span
        class="room-art day"
        role="img"
        aria-label="A pixel-art desk in Morocco by day. Sunlight fills the room and the lamp is off; an arched window looks out over whitewashed rooftops and a minaret."
      ></span>
      <!-- The room's clock (ADR 0027): src/scripts/room.ts fills these in by Rabat time. -->
      <span class="room-window"></span>
      <svg class="room-moon" viewBox="0 0 480 160" preserveAspectRatio="none" aria-hidden="true">
        <path fill="#e8e8fa"></path>
      </svg>
      <span class="room-weather" aria-hidden="true"></span>
      <p class="room-note" hidden>Probably asleep: it is <time>02:00</time> in Rabat.</p>
      {roomObjects.map((item) => (
        <a class="hotspot" href={item.href} data-room={item.id}>
          <span>
            {item.object}: {item.section}
          </span>
        </a>
      ))}
    </div>
    <!-- Open-Meteo's data is CC BY 4.0, which asks for credit next to where it shows (ADR 0029). -->
    <p class="room-credit">
      Weather data by <a href="https://open-meteo.com/">Open-Meteo</a>{' '}
      (<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>); simplified
      visualization.
    </p>
  </section>

  <h1 class="intro">{site.author}. <span>{site.role}, {site.location}.</span></h1>
  <nav aria-label="The room as a list">
    <ul class="room-list">
      {roomObjects.map((item) => (
        <li>
          <a href={item.href} data-room-list={item.id}>
            {item.object} <span>{item.section}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="home-panels">
    <section class="paper" aria-labelledby="writing">
      <div class="panel-head">
        <h2 id="writing">Writing</h2>
        <a href="/writing">All writing</a>
      </div>
      <PostList posts={posts} />
    </section>

    <section class="panel m-screen" aria-labelledby="projects">
      <div class="panel-head">
        <h2 id="projects">Projects</h2>
        <a href="/projects">All projects</a>
      </div>
      <ul class="home-projects">
        {projects.map((project) => (
          <li>
            <a href={projectPath(project.slug)}>{project.slug}</a>
            {project.summary !== null && <p>{project.summary}</p>}
          </li>
        ))}
      </ul>
    </section>

    <div>
      <section class="panel m-vinyl" aria-labelledby="listening">
        <div class="panel-head">
          <h2 id="listening">Listening</h2>
          <a href="/stats#listening">More</a>
        </div>
        <div class="record">
          <div class="disc" aria-hidden="true"></div>
          <NowPlayingPanel listening={listening} />
        </div>
      </section>

      <section class="panel m-cork" aria-labelledby="shipping">
        <div class="panel-head">
          <h2 id="shipping">Shipping</h2>
          <a href="/stats#shipping">More</a>
        </div>
        {recentlyShipped.length === 0 ? (
          <p>Nothing to show yet.</p>
        ) : (
          <>
            <ShippingHeat events={shipping.data?.events ?? []} />
            <ShippingList events={recentlyShipped} />
          </>
        )}
      </section>
    </div>
  </div>
</Base>

<script>
import '../scripts/room.ts';
</script>
