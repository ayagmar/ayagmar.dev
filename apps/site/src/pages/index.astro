---
import { getEntry } from 'astro:content';
import HomeShipping from '../components/HomeShipping.astro';
import NowPlaying from '../components/NowPlaying.astro';
import PostList from '../components/PostList.astro';
import Sample from '../components/Sample.astro';
import { shippingStrip } from '../data/format.ts';
import { roomSeed } from '../data/room.ts';
import { liveAttrs, signals, signalsApiBase, signalsMode } from '../data/signals.ts';
import Base from '../layouts/Base.astro';
import { getDays, getNotes, getPosts, getProjects } from '../lib/posts.ts';
import { projectPath } from '../lib/projects.ts';
import { catName, catNote, hotspotWords, roomObjects } from '../lib/room.ts';
import { roomState, seededInputs } from '../lib/room-state.ts';
import { site } from '../lib/site.ts';
import { moonColour } from '../lib/sky.ts';
import { person, website } from '../lib/structured-data.ts';
import { notePath } from '../lib/til.ts';
import { isoDay } from '../lib/writing.ts';
import '../styles/room.css';

const posts = (await getPosts()).slice(0, 4);
// Until the first post, the Writing window shows the latest TIL notes instead of an empty box.
const notes = posts.length === 0 ? (await getNotes()).slice(0, 3) : [];
const projects = (await getProjects()).projects.slice(0, 5);
const listening = await signals.read('listening');
const shipping = await signals.read('shipping');
const about = await getEntry('about', 'about');
if (about === undefined) throw new Error('content/about.json is missing');
// The strip is drawn once, with the page: from the daily history, else from the events.
const strip = shippingStrip(
  await signals.readDays('shipping-activity'),
  shipping,
  new Date(),
  (await getDays()).dates
);
const recentlyShipped = shipping.data?.events.slice(0, 4) ?? [];
const seed = await roomSeed();
// The page is the room's `built` moment: no clock, so no sky, and every object carries its date.
const room = roomState(seededInputs(seed, true), { kind: 'built', instant: seed.builtAt });
---

<Base structuredData={[website(), person(about.data.identity)]}>
  {/* Its scripts read the API as the page loads; in fixtures mode they make no request. */}
  {signalsMode === 'api' && <link slot="head" rel="preconnect" href={signalsApiBase} crossorigin>}
  <section slot="room" class="room" aria-label="The room">
    <!-- The weather endpoint only in api mode: fixtures mode makes no request (ADR 0029). -->
    <div
      class="scene"
      data-weather-src={signalsMode === 'api' ? `${signalsApiBase}/v1/weather` : undefined}
      data-room-seed={JSON.stringify(seed)}
    >
      <span
        class="room-art night"
        role="img"
        aria-label="A pixel-art desk at night in Morocco. The lamp is on and the monitor glows; an arched window looks out over rooftops and Hassan Tower."
      ></span>
      <span
        class="room-art day"
        role="img"
        aria-label="A pixel-art desk in Morocco, in a whitewashed room; an arched window looks out over rooftops and Hassan Tower. The window's own label says what the sky is doing."
      ></span>
      {/* What the room holds, from its state (ADR 0043): picture only, as each hotspot says it. */}
      <ul class="room-pins room-lit" aria-hidden="true">
        {room.pins.pins.map((pin) => (
          <li data-kind={pin.kind}>
            {Array.from({ length: Math.min(pin.count, 3) }, () => (
              <i></i>
            ))}
          </li>
        ))}
      </ul>
      <div class="room-screen heat room-lit" aria-hidden="true">
        {room.screen.cells.map((cell) => <i data-l={cell.level ?? 'none'}></i>)}
      </div>
      <ol class="room-books room-lit" aria-hidden="true">
        {room.shelf.books.map((book) => <li data-tone={book.tone}></li>)}
      </ol>
      <span class="room-record" aria-hidden="true"></span>
      <!-- The room's clock (ADR 0027): src/scripts/room.ts fills these in by Rabat time. -->
      <span class="room-window"></span>
      <svg class="room-moon" viewBox="0 0 480 160" preserveAspectRatio="none" aria-hidden="true">
        <path fill={moonColour}></path>
      </svg>
      <span class="room-weather" aria-hidden="true"></span>
      <p class="room-note" hidden>Probably asleep: it is <time>02:00</time> in Rabat.</p>
      {/* Shown 02:00 to 05:00 in Rabat, by `data-cat`. The art is a layer of the whole scene; the
          spot over the cat holds its name and the note shown on hover and focus. */}
      <span class="room-cat">
        {/* biome-ignore lint/a11y/noNoninteractiveTabindex: focusable so the keyboard gets the note a pointer gets on hover (WCAG 1.4.13); it does nothing else. */}
        <span class="room-cat-spot" tabindex="0" role="img" aria-label={catName}>
          <span aria-hidden="true">{catNote}</span>
        </span>
      </span>
      {roomObjects.map((item) => (
        <a class="hotspot" href={item.href} data-room={item.id}>
          <span>{hotspotWords(item, room)}</span>
        </a>
      ))}
    </div>
    {room.sample && <Sample />}
    <!-- Open-Meteo's CC BY 4.0 credit is on the colophon, linked from the footer (ADR 0029). -->
  </section>

  <h1 class="intro">{site.author} <span>{site.role}, {site.location}.</span></h1>
  <nav aria-label="The room as a list">
    <ul class="room-list">
      {roomObjects.map((item) => (
        <li>
          <a href={item.href} data-room-list={item.id}>
            <span class="room-object">{item.object}</span>{' '}
            <span class="room-section">{item.section}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="home-panels">
    {/* A section appears once it has something in it; the room still leads to its page. */}
    {(posts.length > 0 || notes.length > 0) && (
      <section class="paper" aria-labelledby="writing">
        <div class="panel-head">
          <h2 id="writing">Writing</h2>
          {notes.length === 0 ? <a href="/writing">All writing</a> : <a href="/til">All notes</a>}
        </div>
        {notes.length === 0 ? (
          <PostList posts={posts} />
        ) : (
          <>
            <p class="home-notes-lede">No posts yet. The latest short notes, from TIL:</p>
            <ul class="home-notes">
              {notes.map((note) => (
                <li>
                  <time datetime={isoDay(note.data.date)}>{isoDay(note.data.date)}</time>
                  <a href={notePath(note.id)}>{note.data.title}</a>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )}

    <section class="panel m-screen" aria-labelledby="projects">
      <div class="panel-head">
        <h2 id="projects">Projects</h2>
        <a href="/projects">All projects</a>
      </div>
      <ul class="home-projects">
        {projects.map((project) => (
          <li>
            <a href={projectPath(project.slug)}>{project.slug}</a>
            {project.summary !== null && <p>{project.summary}</p>}
          </li>
        ))}
      </ul>
    </section>

    <div>
      <section
        class="panel m-vinyl"
        aria-labelledby="listening"
        {...liveAttrs('listening', listening)}
      >
        <div class="panel-head">
          <h2 id="listening">Listening</h2>
          <a href="/stats#listening">More</a>
        </div>
        <div class="record">
          <div class="disc" aria-hidden="true"></div>
          <NowPlaying listening={listening} />
        </div>
        {listening.data !== null && <Sample />}
      </section>

      {(strip !== null || recentlyShipped.length > 0) && (
        <section class="panel m-cork" aria-labelledby="shipping">
          <div class="panel-head">
            <h2 id="shipping">Shipping</h2>
            <a href="/stats#shipping">More</a>
          </div>
          <HomeShipping strip={strip} events={recentlyShipped} />
          <Sample />
        </section>
      )}
    </div>
  </div>
</Base>

<script>
import '../scripts/room.ts';
</script>
