---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import {
  aboutLinks,
  certificationExpiry,
  contactLine,
  formatMonth,
  monthSpan as span,
} from '../data/about.ts';
import Base from '../layouts/Base.astro';
import { imageFor } from '../lib/content-images.ts';
import { person, profilePage, website } from '../lib/structured-data.ts';

// content/about.json, validated by the collection schema in content.config.ts.
const entry = await getEntry('about', 'about');
if (entry === undefined) throw new Error('content/about.json is missing');
const about = entry.data;
const { identity } = about;
const links = aboutLinks(identity);
const built = new Date();
---

<Base
  title="About"
  description={about.summary}
  structuredData={[website(), person(identity), profilePage('/about')]}
>
  <div class="column" data-pagefind-body data-pagefind-meta="title:About">
    <header class="panel m-tea t-about">
      <h1>{identity.name}</h1>
      <p class="lede">{about.summary}</p>
      <p class="about-contact">
        {contactLine(identity).map((part) =>
          typeof part === 'string' ? part : <a href={part.href}>{part.label}</a>
        )}
      </p>
      <p class="lede-aside">{about.nameNote}</p>
    </header>

    <div class="paper t-cv">
      <section aria-labelledby="experience">
        <h2 id="experience">Experience</h2>
        <ol class="timeline">
          {about.experience.map((role) => {
            const dates = span(role.start, role.end);
            return (
              <li>
                <h3>
                  {role.role}, {role.company}
                </h3>
                <p>
                  {role.place}, <time datetime={role.start}>{dates.start}</time> to{' '}
                  {role.end === null ? dates.end : <time datetime={role.end}>{dates.end}</time>}
                </p>
                {role.outcomes.length > 0 && (
                  <ul>
                    {role.outcomes.map((outcome) => (
                      <li>{outcome}</li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ol>
      </section>

      <section aria-labelledby="certifications">
        <h2 id="certifications">Certifications</h2>
        <ul class="certs">
          {about.certifications.map((cert) => {
            const expiry =
              cert.expires === undefined ? undefined : certificationExpiry(cert.expires, built);
            return (
              <li class="cert" data-state={expiry?.state}>
                {/* The name is in the heading beside it, so the badge is decorative. One with no
                    badge gets the issuer's initial in the site's type. */}
                {cert.badge === undefined ? (
                  <span class="cert-mark" aria-hidden="true">
                    {cert.issuer.slice(0, 1)}
                  </span>
                ) : (
                  <Image
                    class="cert-badge"
                    src={imageFor('badges', cert.badge.file)}
                    alt=""
                    height={56}
                    densities={[1, 2]}
                  />
                )}
                <div>
                  <h3>{cert.name}</h3>
                  <p>
                    {cert.issuer}, issued{' '}
                    <time datetime={cert.issued}>{formatMonth(cert.issued)}</time>
                  </p>
                  {expiry !== undefined && (
                    <p class="cert-expiry">
                      {expiry.lead} <time datetime={cert.expires}>{expiry.month}</time>
                    </p>
                  )}
                  {cert.credentialId !== undefined && (
                    <p>
                      Credential ID <span class="cert-id">{cert.credentialId}</span>
                    </p>
                  )}
                  <p class="cert-verify">
                    <a href={cert.verifyUrl} aria-label={`Verify ${cert.name}`}>
                      Verify
                    </a>
                  </p>
                </div>
              </li>
            );
          })}
        </ul>
      </section>

      <section aria-labelledby="education">
        <h2 id="education">Education</h2>
        <ul class="timeline">
          {about.education.map((school) => {
            const dates = span(school.start, school.end);
            return (
              <li>
                <h3>{school.school}</h3>
                <p>
                  {school.field === undefined ? school.degree : `${school.degree}, ${school.field}`}
                  , <time datetime={school.start}>{dates.start}</time> to{' '}
                  <time datetime={school.end}>{dates.end}</time>
                </p>
              </li>
            );
          })}
        </ul>
      </section>

      <section aria-labelledby="stack">
        <h2 id="stack">Stack</h2>
        <p>{about.stack.join(', ')}</p>
      </section>

      <section aria-labelledby="elsewhere">
        <h2 id="elsewhere">Elsewhere</h2>
        <ul class="inline-list">
          {links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Base>
