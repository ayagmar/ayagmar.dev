---
import { getEntry, render } from 'astro:content';
import Brewing from '../components/Brewing.astro';
import Base from '../layouts/Base.astro';
import { staleAfterDays } from '../lib/now.ts';
import { updatedOn } from '../lib/plaintext.ts';
import { nowPage } from '../lib/site.ts';
import { isoDay } from '../lib/writing.ts';

// content/now.md, validated by the collection schema in content.config.ts (ADR 0035).
const entry = await getEntry('now', 'now');
if (entry === undefined) throw new Error('content/now.md is missing');
const { updated, brewing } = entry.data;
const { Content } = await render(entry);
const day = isoDay(updated);
---

<Base
  title={nowPage.label}
  description="What Abdeslam Yassine Agmar is working on and thinking about this month."
>
  <div class="column" data-pagefind-body data-pagefind-meta={`title:${nowPage.label}`}>
    <header class="intro">
      <h1>Now</h1>
      <p class="caption" data-pagefind-ignore>
        Updated <time datetime={day}>{updatedOn(updated)}</time>.
      </p>
      {/* Shown by src/scripts/now.ts against the reader's clock; never claims freshness itself. */}
      <p
        class="caption stale"
        data-pagefind-ignore
        data-stale-after={staleAfterDays}
        data-updated={day}
        hidden
      >
        This page may be out of date: it was last updated more than {staleAfterDays} days ago.
      </p>
    </header>

    <Brewing items={brewing} />

    <div class="paper t-now">
      <div class="prose">
        <Content />
      </div>
    </div>
  </div>
</Base>

<script>
import '../scripts/now.ts';
</script>
