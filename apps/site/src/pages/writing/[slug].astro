---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PostHeader from '../../components/PostHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Base from '../../layouts/Base.astro';
import { renderArt } from '../../lib/art.ts';
import { diagramStyles } from '../../lib/markdown/diagrams.ts';
import { getPosts, getProjects } from '../../lib/posts.ts';
import { morePostsAbout } from '../../lib/projects.ts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const { projects, envelope } = await getProjects();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      envelope,
      // In the post's own order, which is the order the author listed them.
      cards: post.data.projects.flatMap((slug) => {
        const project = projects.find((candidate) => candidate.slug === slug);
        return project === undefined
          ? []
          : [{ project, more: morePostsAbout(posts, slug, post.id) }];
      }),
    },
  }));
}) satisfies GetStaticPaths;

const { post, envelope, cards } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const hasDiagrams = Object.keys(diagramStyles(remarkPluginFrontmatter)).length > 0;
const { title, summary, art } = post.data;
---

<Base title={title} description={summary}>
  {hasDiagrams && <link slot="head" rel="stylesheet" href="/diagrams.css">}
  <article class="paper post" data-pagefind-body>
    <PostHeader post={post}>
      {art !== undefined && <Fragment slot="art" set:html={renderArt(post.id, art)} />}
    </PostHeader>
    <div class="prose">
      <Content />
    </div>
  </article>
  {cards.map(({ project, more }) => (
    <ProjectCard project={project} envelope={envelope} more={more} />
  ))}
</Base>
