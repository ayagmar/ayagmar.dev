---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, getProjects } from '../../lib/posts.ts';
import { morePostsAbout, projectPath } from '../../lib/projects.ts';
import { isoDay, tagPath } from '../../lib/writing.ts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const { projects, envelope } = await getProjects();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      envelope,
      // In the post's own order, which is the order the author listed them.
      cards: post.data.projects.flatMap((slug) => {
        const project = projects.find((candidate) => candidate.slug === slug);
        return project === undefined
          ? []
          : [{ project, more: morePostsAbout(posts, slug, post.id) }];
      }),
    },
  }));
}) satisfies GetStaticPaths;

const { post, envelope, cards } = Astro.props;
const { Content } = await render(post);
const { title, summary, date, updated, tags, draft, projects } = post.data;
---

<Base title={title} description={summary}>
  <article data-pagefind-body>
    <header>
      <h1>{title}</h1>
      {draft && (
        <p>
          <strong>Draft:</strong> not published yet.
        </p>
      )}
      <p>
        Published <time datetime={isoDay(date)}>{isoDay(date)}</time>
        {updated && (
          <>
            , last updated <time datetime={isoDay(updated)}>{isoDay(updated)}</time>
          </>
        )}
      </p>
      {tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {tags.map((tag) => (
            <li>
              <a href={tagPath(tag)}>{tag}</a>
            </li>
          ))}
        </ul>
      )}
      {projects.length > 0 && (
        <ul class="post-projects" aria-label="Projects">
          {projects.map((slug) => (
            <li>
              <a href={projectPath(slug)} data-pagefind-filter="project">
                {slug}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>
    <Content />
  </article>
  {cards.map(({ project, more }) => (
    <ProjectCard project={project} envelope={envelope} more={more} />
  ))}
</Base>
