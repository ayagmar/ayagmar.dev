---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { diagramStyles } from '../../lib/markdown/diagrams.ts';
import { getPosts } from '../../lib/posts.ts';
import { isoDay, tagPath } from '../../lib/writing.ts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const hasDiagrams = Object.keys(diagramStyles(remarkPluginFrontmatter)).length > 0;
const { title, summary, date, updated, tags, draft } = post.data;
---

<Base title={title} description={summary}>
  {hasDiagrams && <link slot="head" rel="stylesheet" href="/diagrams.css">}
  <article data-pagefind-body>
    <header>
      <h1>{title}</h1>
      {draft && (
        <p>
          <strong>Draft:</strong> not published yet.
        </p>
      )}
      <p>
        Published <time datetime={isoDay(date)}>{isoDay(date)}</time>
        {updated && (
          <>
            , last updated <time datetime={isoDay(updated)}>{isoDay(updated)}</time>
          </>
        )}
      </p>
      {tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {tags.map((tag) => (
            <li>
              <a href={tagPath(tag)}>{tag}</a>
            </li>
          ))}
        </ul>
      )}
    </header>
    <Content />
  </article>
</Base>
