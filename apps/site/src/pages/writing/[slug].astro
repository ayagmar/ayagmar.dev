---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Comments from '../../components/Comments.astro';
import PostHeader from '../../components/PostHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ReplyByEmail from '../../components/ReplyByEmail.astro';
import Toc from '../../components/Toc.astro';
import Base from '../../layouts/Base.astro';
import { renderArt } from '../../lib/art.ts';
import { postReceipt, projectRepos } from '../../lib/days.ts';
import { diagramStyles } from '../../lib/markdown/diagrams.ts';
import { postOgImage } from '../../lib/og.ts';
import { getDays, getPosts, getProjects } from '../../lib/posts.ts';
import { morePostsAbout } from '../../lib/projects.ts';
import { blogPosting, breadcrumbs } from '../../lib/structured-data.ts';
import { isoDay, postPath } from '../../lib/writing.ts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const { projects, envelope } = await getProjects();
  const { history } = await getDays();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      envelope,
      receipt:
        post.data.receipts === undefined
          ? null
          : postReceipt(
              history,
              {
                from: isoDay(post.data.receipts.from),
                to: isoDay(post.data.receipts.to),
                repos: post.data.receipts.repos,
              },
              projectRepos(post.data.projects)
            ),
      // In the post's own order, which is the order the author listed them.
      cards: post.data.projects.flatMap((slug) => {
        const project = projects.find((candidate) => candidate.slug === slug);
        return project === undefined
          ? []
          : [{ project, more: morePostsAbout(posts, slug, post.id) }];
      }),
    },
  }));
}) satisfies GetStaticPaths;

const { post, envelope, cards, receipt } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const hasDiagrams = Object.keys(diagramStyles(remarkPluginFrontmatter)).length > 0;
const { title, summary, art, date, updated, tags, draft } = post.data;
const image = postOgImage(post.id, title, art !== undefined);
const path = postPath(post.id);
const structuredData = [
  blogPosting({
    path,
    title,
    description: summary,
    published: date,
    modified: updated,
    tags,
    image: image.path,
  }),
  breadcrumbs([
    { name: 'Writing', path: '/writing' },
    { name: title, path },
  ]),
];
---

{/* A draft is only built for Previews (ADR 0028), and stays out of search there too. */}
<Base {title} description={summary} {image} {structuredData} noindex={draft}>
  {hasDiagrams && <link slot="head" rel="stylesheet" href="/diagrams.css">}
  <article class="reader" data-pagefind-body>
    <PostHeader post={post} receipt={receipt}>
      {art !== undefined && <Fragment slot="art" set:html={renderArt(post.id, art)} />}
    </PostHeader>
    <Toc headings={headings} />
    <div class="prose">
      <Content />
    </div>
    <ReplyByEmail title={title} />
    <Comments collection="writing" slug={post.id} />
  </article>
  {cards.map(({ project, more }) => (
    <ProjectCard project={project} envelope={envelope} more={more} />
  ))}
</Base>
