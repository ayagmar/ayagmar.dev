---
import type { GetStaticPaths } from 'astro';
import PostList from '../../../components/PostList.astro';
import Base from '../../../layouts/Base.astro';
import { feedPaths } from '../../../lib/feed.ts';
import { getPosts } from '../../../lib/posts.ts';
import { postsByTag } from '../../../lib/writing.ts';

export const getStaticPaths = (async () => {
  const byTag = postsByTag(await getPosts());
  return [...byTag].map(([tag, posts]) => ({ params: { tag }, props: { posts } }));
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { posts } = Astro.props;
const feeds = feedPaths({ tag });
---

{/* A filtered copy of /writing with no text of its own: kept for readers and its feeds, out of
     search results and the sitemap. */}
<Base
  title={`Tagged ${tag}`}
  description={`Posts on min7 tagged ${tag}, newest first, with RSS and Atom feeds for the tag.`}
  feed={{ tag }}
  noindex
>
  <div class="paper column">
    <h1>Tagged {tag}</h1>
    <PostList posts={posts} />
    <p class="caption">
      Follow this tag: <a href={feeds.rss}>RSS</a>, <a href={feeds.atom}>Atom</a>.
    </p>
  </div>
</Base>
