---
import Onward from '../components/Onward.astro';
import Base from '../layouts/Base.astro';
import { getNotes, getPosts } from '../lib/posts.ts';
import { pagesToRead } from '../lib/writing.ts';

const counts = { posts: (await getPosts()).length, notes: (await getNotes()).length };
---

<Base title="Not found" description="No page lives at this address on min7." noindex>
  <div class="paper column t-error">
    <h1>Nothing here</h1>
    <p>No page lives at this address.</p>
    <Onward pages={[...pagesToRead(counts), { href: '/', label: 'the home page' }]}>
      <!-- Search exists only with scripts on; base.css shows one of the two. The island opens
           the dialog for the button (src/components/Search.svelte). -->
      <span class="search-script">
        Try <button type="button" class="inline-button" data-search-open>Search</button>, or one of
        these:
      </span>
      <span class="search-no-script">Try one of these:</span>
    </Onward>
  </div>
</Base>
