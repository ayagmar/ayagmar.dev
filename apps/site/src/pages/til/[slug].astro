---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Comments from '../../components/Comments.astro';
import PostHeader from '../../components/PostHeader.astro';
import ReplyByEmail from '../../components/ReplyByEmail.astro';
import Toc from '../../components/Toc.astro';
import Base from '../../layouts/Base.astro';
import { diagramStyles } from '../../lib/markdown/diagrams.ts';
import { noteOgImage } from '../../lib/og.ts';
import { getNotes } from '../../lib/posts.ts';
import { blogPosting, breadcrumbs } from '../../lib/structured-data.ts';
import { notePath, noteSummary } from '../../lib/til.ts';

export const getStaticPaths = (async () =>
  (await getNotes()).map((note) => ({
    params: { slug: note.id },
    props: { note },
  }))) satisfies GetStaticPaths;

const { note } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(note);
const hasDiagrams = Object.keys(diagramStyles(remarkPluginFrontmatter)).length > 0;
const { title, date, tags, draft } = note.data;
const description = noteSummary(note);
const image = noteOgImage(note.id, title);
const path = notePath(note.id);
const structuredData = [
  blogPosting({ path, title, description, published: date, tags, image: image.path }),
  breadcrumbs([
    { name: 'TIL', path: '/til' },
    { name: title, path },
  ]),
];
---

{/* A draft is only built for Previews (ADR 0028), and stays out of search there too. */}
<Base {title} {description} feed={{ til: true }} {image} {structuredData} noindex={draft}>
  {hasDiagrams && <link slot="head" rel="stylesheet" href="/diagrams.css">}
  <article class="reader" data-pagefind-body>
    <!-- Search shows this as the result's title, so a note reads "TIL: ..." (ADR 0028). -->
    <span hidden data-pagefind-meta="title">TIL: {note.data.title}</span>
    <PostHeader post={note} linkTags={false} />
    <Toc headings={headings} idPrefix={`${note.id}-`} />
    <div class="prose">
      <Content />
    </div>
    <ReplyByEmail title={note.data.title} />
    <Comments collection="til" slug={note.id} />
    <p class="caption" data-pagefind-ignore><a href="/til">All notes</a></p>
  </article>
</Base>
