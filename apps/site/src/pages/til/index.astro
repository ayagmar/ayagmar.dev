---
import { render } from 'astro:content';
import Onward from '../../components/Onward.astro';
import TilNote from '../../components/TilNote.astro';
import Base from '../../layouts/Base.astro';
import { feedPaths } from '../../lib/feed.ts';
import { diagramStyles } from '../../lib/markdown/diagrams.ts';
import { getNotes, getPosts } from '../../lib/posts.ts';
import { meanwhile, nothingYet, pagesToRead } from '../../lib/writing.ts';

const notes = await Promise.all(
  (await getNotes()).map(async (note) => ({ note, ...(await render(note)) }))
);
const hasDiagrams = notes.some(
  ({ remarkPluginFrontmatter }) => Object.keys(diagramStyles(remarkPluginFrontmatter)).length > 0
);
const feeds = feedPaths({ til: true });
const posts = await getPosts();
---

<Base
  title="Today I learned"
  description="Short notes on things I learned, newest first."
  feed={{ til: true }}
>
  {hasDiagrams && <link slot="head" rel="stylesheet" href="/diagrams.css">}
  <div class="reader column">
    <h1>Today I learned</h1>
    {notes.length === 0 ? (
      <>
        <p>{nothingYet.til}</p>
        <Onward lead={meanwhile} pages={pagesToRead({ posts: posts.length, notes: 0 })} />
      </>
    ) : (
      notes.map(({ note, Content }, index) => (
        <>
          {index > 0 && <hr>}
          <TilNote id={note.id} data={note.data}>
            <Content />
          </TilNote>
        </>
      ))
    )}
    <p class="caption">
      Follow the notes: <a href={feeds.rss}>RSS</a>, <a href={feeds.atom}>Atom</a>.
    </p>
  </div>
</Base>
