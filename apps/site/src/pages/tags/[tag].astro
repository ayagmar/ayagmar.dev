---
import type { GetStaticPaths } from 'astro';
import PostList from '../../components/PostList.astro';
import TilNote from '../../components/TilNote.astro';
import Base from '../../layouts/Base.astro';
import { type FeedScope, feedPaths } from '../../lib/feed.ts';
import { getNotes, getPosts } from '../../lib/posts.ts';
import { noteSummary } from '../../lib/til.ts';
import { readingMinutes, taggedEntries } from '../../lib/writing.ts';

export const getStaticPaths = (async () =>
  taggedEntries(await getPosts(), await getNotes()).map(({ tag, posts, notes }) => ({
    params: { tag },
    props: { posts, notes },
  }))) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { posts, notes } = Astro.props;
// The writing feeds carry posts only (ADR 0028), so a tag without posts offers the TIL feeds.
const scope: FeedScope = posts.length > 0 ? { tag } : { til: true };
const feeds = feedPaths(scope);
const listed = posts.length === 0 ? 'Notes' : notes.length === 0 ? 'Posts' : 'Posts and notes';
---

{/* A filtered view of /writing and /til with no text of its own: kept for readers and its
     feeds, out of search results and the sitemap. */}
<Base
  title={`Tagged ${tag}`}
  description={`${listed} on min7 tagged ${tag}, newest first.`}
  feed={scope}
  noindex
>
  <div class="paper column">
    <h1>Tagged {tag}</h1>
    {posts.length > 0 && (
      <section aria-labelledby="tag-posts">
        <h2 id="tag-posts">Posts</h2>
        <PostList posts={posts} />
      </section>
    )}
    {notes.length > 0 && (
      <section aria-labelledby="tag-notes">
        <h2 id="tag-notes">Notes</h2>
        {notes.map((note) => (
          <TilNote
            id={note.id}
            data={note.data}
            summary={noteSummary(note)}
            minutes={readingMinutes(note.body ?? '')}
            level={3}
          />
        ))}
      </section>
    )}
    <p class="caption">
      {posts.length > 0 ? 'Follow this tag' : 'Follow the notes'}: <a href={feeds.rss}>RSS</a>,{' '}
      <a href={feeds.atom}>Atom</a>.
    </p>
  </div>
</Base>
