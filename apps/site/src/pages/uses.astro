---
import { getEntry } from 'astro:content';
import { signalsApiBase, signalsMode } from '../data/signals.ts';
import Base from '../layouts/Base.astro';

// content/uses.json, validated by the collection schema in content.config.ts.
const entry = await getEntry('uses', 'uses');
if (entry === undefined) throw new Error('content/uses.json is missing');
const uses = entry.data;
// The live part is read by the browser (ADR 0015): in fixtures mode it has no endpoint and
// never shows.
const api = (source: string) =>
  signalsMode === 'api' ? `${signalsApiBase}/v1/${source}` : undefined;
---

<Base title="Uses" description={uses.intro}>
  {/* Its scripts read the API as the page loads; in fixtures mode they make no request. */}
  {signalsMode === 'api' && <link slot="head" rel="preconnect" href={signalsApiBase} crossorigin>}
  <div class="column">
    <h1>Uses</h1>
    <p class="caption">{uses.intro}</p>

    <div class="uses">
      {uses.sections.map((section, i) => (
        <section class="panel" aria-labelledby={`uses-${i}`}>
          <h2 id={`uses-${i}`}>{section.title}</h2>
          <ul>
            {section.items.map((item) => (
              <li>
                <span>{item.name}</span>
                {item.detail && (
                  <span class="uses-detail">
                    <span class="sr-only">, </span>
                    {item.detail}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}

      {uses.machines.map((machine, i) => (
        <section class="panel" aria-labelledby={`machine-${i}`}>
          <h2 id={`machine-${i}`}>{machine.name}</h2>
          {machine.model && <p>{machine.model}</p>}
          <dl>
            {machine.specs.map((spec) => (
              <div>
                <dt>{spec.part}</dt>
                <dd>{spec.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}

      {/* Filled in, and shown, by src/scripts/uses.ts; hidden without it. */}
      <section class="panel uses-live" aria-labelledby="uses-live" hidden>
        <h2 id="uses-live">From my machines</h2>
        <div class="desktop-facts" data-desktop-src={api('desktop')} hidden>
          <h3>Desktop</h3>
          <dl>
            <div class="desktop-kernel">
              <dt>Kernel</dt>
              <dd></dd>
            </div>
            <div class="desktop-niri">
              <dt>niri</dt>
              <dd></dd>
            </div>
            <div class="desktop-uptime">
              <dt>Uptime</dt>
              <dd></dd>
            </div>
          </dl>
          <p class="freshness desktop-reported"></p>
        </div>
        <div class="agents-month" data-llm-usage-src={api('llm-usage')} hidden>
          <h3>Agents this month</h3>
          <p>Most tokens first:</p>
          <ol></ol>
          <p class="freshness agents-as-of"></p>
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
/* One column of quiet rows: a thing on the left, what it is muted on the right. */
.uses ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.uses li,
.uses dl > div:not([hidden]) {
  display: flex;
  flex-wrap: wrap;
  gap: 0 1.5rem;
  justify-content: space-between;
  padding-block: 0.5rem;
  border-bottom: 1px solid var(--rule);
}

.uses li:first-child,
.uses dl > div:first-child {
  padding-top: 0;
}

/* The next section's rule closes the list. */
.uses li:last-child,
.uses dl > div:last-child {
  border-bottom: 0;
}

.uses-detail,
.uses dt {
  color: var(--fg-2);
}

/* Right-aligned only where it fits beside its name; under it on a phone, flush left. */
@media (min-width: 30rem) {
  .uses-detail {
    text-align: end;
  }
}

.uses dl > div:not([hidden]) {
  display: grid;
  grid-template-columns: 6rem minmax(0, 1fr);
  gap: 1rem;
}

.uses dd {
  margin: 0;
  overflow-wrap: anywhere;
}
</style>

<script>
import '../scripts/uses.ts';
</script>
