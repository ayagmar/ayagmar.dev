---
import Search from '../components/Search.svelte';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import serifRoman from '../fonts/serif-roman.woff2?url';
import { type FeedScope, feedPaths, feedScope } from '../lib/feed.ts';
import { nav, publicPath, site } from '../lib/site.ts';
import themeScript from '../scripts/theme.js?url&no-inline';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
  /** Adds discovery links for this tag's or project's feeds next to the site-wide ones. */
  feed?: FeedScope;
}

const { title, description = site.description, feed } = Astro.props;
const pageTitle = title === undefined ? site.name : `${title} | ${site.name}`;
const current = publicPath(Astro.url.pathname);
const canonical = new URL(current, Astro.site);
const feeds = [undefined, ...(feed === undefined ? [] : [feed])].map((scope) => ({
  ...feedPaths(scope),
  label: feedScope(scope).title,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <link rel="preload" href={serifRoman} as="font" type="font/woff2" crossorigin>
    <title>{pageTitle}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    {feeds.map((feed) => (
      <>
        <link
          rel="alternate"
          type="application/rss+xml"
          title={`${feed.label} (RSS)`}
          href={feed.rss}
        />
        <link
          rel="alternate"
          type="application/atom+xml"
          title={`${feed.label} (Atom)`}
          href={feed.atom}
        />
      </>
    ))}
    <link rel="sitemap" href="/sitemap-index.xml">
    <slot name="head" />
    <!-- Blocking on purpose: puts the stored theme on <html> before the first paint (ADR 0026). -->
    <script is:inline src={themeScript}></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-current={current === '/' ? 'page' : undefined}>
        <span>min</span><span>7</span>
      </a>
      <nav aria-label="Site">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="site-tools">
        <Search client:idle />
        <ThemeSwitch />
      </div>
    </header>
    <main id="main">
      <slot name="room" />
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer wrap">
      <p>{site.name}: static pages, no tracking.</p>
      <ul>
        <li><a href={feedPaths().rss}>RSS</a></li>
        <li><a href={feedPaths().atom}>Atom</a></li>
        <li><a href="/colophon">Colophon</a></li>
        <li><a href={site.links.github}>GitHub</a></li>
      </ul>
    </footer>
  </body>
</html>
