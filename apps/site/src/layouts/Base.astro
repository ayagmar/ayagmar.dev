---
import { WORKERS_CI_BRANCH } from 'astro:env/server';
import Search from '../components/Search.svelte';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import mono from '../fonts/mono.woff2?url';
import serifRoman from '../fonts/serif-roman.woff2?url';
import { type FeedScope, feedPaths, feedScope } from '../lib/feed.ts';
import { buildOrigin, defaultOgImage, type OgImage, ogSize } from '../lib/og.ts';
import { roomObjects } from '../lib/room.ts';
import { siteVerification } from '../lib/search.ts';
import { nav, nowPage, publicPath, site } from '../lib/site.ts';
import { jsonLd, type StructuredData } from '../lib/structured-data.ts';
import themeScript from '../scripts/theme.js?url&no-inline';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
  /** Adds discovery links for this tag's or project's feeds next to the site-wide ones. */
  feed?: FeedScope;
  /** The link-preview image; pages without their own share the room's (src/lib/og.ts). */
  image?: OgImage;
  /** schema.org nodes about this page (src/lib/structured-data.ts). */
  structuredData?: StructuredData[];
  /** Keeps the page out of search results and the sitemap (src/lib/sitemap.ts). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  feed,
  image = defaultOgImage,
  structuredData = [],
  noindex = false,
} = Astro.props;
const pageTitle = title === undefined ? site.title : `${title} | ${site.name}`;
const current = publicPath(Astro.url.pathname);
const canonical = new URL(current, Astro.site);
// The canonical URL stays production; a link preview points where this build is served.
const origin = buildOrigin(WORKERS_CI_BRANCH);
const feeds = [undefined, ...(feed === undefined ? [] : [feed])].map((scope) => ({
  ...feedPaths(scope),
  label: feedScope(scope).title,
}));
---

<!doctype html>
<html lang="en">
  <!--
    Hello, view-source reader. min7 is static HTML from Astro with one small island, and the room
    on the home page is drawn by a Python script, dithered onto 41 colours. The source is at
    https://github.com/ayagmar/ayagmar.dev. Press ? for the keyboard, or run `curl ayagmar.dev`.
  -->
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    {/* Both faces the page sets, so neither swaps in after the first paint and rewraps text
         (CLS, ADR 0017). The display face is gone, so this is fewer bytes than before. */}
    <link rel="preload" href={serifRoman} as="font" type="font/woff2" crossorigin>
    <link rel="preload" href={mono} as="font" type="font/woff2" crossorigin>
    <title>{pageTitle}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    {noindex && <meta name="robots" content="noindex">}
    {siteVerification.google !== '' && (
      <meta name="google-site-verification" content={siteVerification.google}>
    )}
    {siteVerification.bing !== '' && <meta name="msvalidate.01" content={siteVerification.bing}>}
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content={site.name}>
    <meta property="og:title" content={title ?? site.title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={new URL(current, origin)}>
    <meta property="og:image" content={new URL(image.path, origin)}>
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content={String(ogSize.width)}>
    <meta property="og:image:height" content={String(ogSize.height)}>
    <meta property="og:image:alt" content={image.alt}>
    <meta name="twitter:card" content="summary_large_image">
    {feeds.map((feed) => (
      <>
        <link
          rel="alternate"
          type="application/rss+xml"
          title={`${feed.label} (RSS)`}
          href={feed.rss}
        />
        <link
          rel="alternate"
          type="application/atom+xml"
          title={`${feed.label} (Atom)`}
          href={feed.atom}
        />
      </>
    ))}
    <link rel="sitemap" href="/sitemap-index.xml">
    {structuredData.length > 0 && (
      <script is:inline type="application/ld+json" set:html={jsonLd(structuredData)} />
    )}
    <slot name="head" />
    <!-- Blocking on purpose: puts the stored theme on <html> before the first paint (ADR 0026). -->
    <script is:inline src={themeScript}></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-current={current === '/' ? 'page' : undefined}>
        <span>min</span><span>7</span>
      </a>
      <div class="site-tools">
        <Search client:idle />
      </div>
      <!-- On phones the nav and the theme switch sit in a popover this button opens, with no
           script (base.css); from 52rem they are part of the header row. Search comes before them
           so that when it hydrates and changes width, the right edge of the row holds still. -->
      <button type="button" class="menu-open" popovertarget="site-menu">Menu</button>
      <nav id="site-menu" popover aria-label="Site">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <ThemeSwitch />
      </nav>
    </header>
    <main id="main">
      <slot name="room" />
      <div class="wrap">
        <slot />
      </div>
    </main>
    <!-- Opened with ? or the footer's Keys button by src/scripts/theme.js, which also keeps the
         switch; the room's keys are in src/scripts/room.ts. -->
    <dialog class="keys" aria-labelledby="keys-title">
      <h2 id="keys-title">Keyboard</h2>
      <dl>
        <dt><kbd>/</kbd> or <kbd>Ctrl K</kbd></dt>
        <dd>Search</dd>
        <dt><kbd>t</kbd></dt>
        <dd>Swap day and night</dd>
        {current === '/' &&
          roomObjects.map((item, index) => (
            <>
              <dt>
                <kbd>{index + 1}</kbd>
              </dt>
              <dd>
                {item.object}: {item.section}
              </dd>
            </>
          ))}
        <dt><kbd>?</kbd></dt>
        <dd>This list</dd>
      </dl>
      <label>
        {/* biome-ignore lint/a11y/useAriaPropsForRole: a checkbox has its own checked state; ARIA in HTML says not to add aria-checked to one. */}
        <input type="checkbox" role="switch" data-shortcuts checked>
        Single-key shortcuts (all but Ctrl K)
      </label>
      <form method="dialog">
        <button type="submit">Close</button>
      </form>
    </dialog>
    <footer class="site-footer wrap">
      <p>{site.name}: static pages, no tracking.</p>
      <ul>
        <li><a href={feedPaths().rss}>RSS</a></li>
        <li><a href={feedPaths().atom}>Atom</a></li>
        <li><a href={nowPage.href}>{nowPage.label}</a></li>
        <li><a href="/colophon">Colophon</a></li>
        <li><a href="/uses">Uses</a></li>
        <li><a href={site.links.github}>GitHub</a></li>
        <li><button type="button" class="keys-open" data-keys-open>Keys</button></li>
      </ul>
    </footer>
  </body>
</html>
