---
import { projectPath } from '../lib/projects.ts';
import { isoDay, readingMinutes, tagPath } from '../lib/writing.ts';
import type { WritingFrontmatter } from '../lib/writing-schema.ts';

interface Props {
  /** A post, or a TIL note, which has neither `updated` nor `projects`. */
  post: {
    id: string;
    body?: string;
    data: Pick<WritingFrontmatter, 'title' | 'date' | 'tags' | 'draft'> &
      Partial<Pick<WritingFrontmatter, 'updated' | 'projects'>>;
  };
  /** Tags link to their writing page; a note's tags have none, so they are plain text. */
  linkTags?: boolean;
  /** The folder the file bar shows the file in: `writing` for posts, `til` for notes. */
  folder?: 'writing' | 'til';
}

const { post, linkTags = true, folder = 'writing' } = Astro.props;
const { title, date, updated, tags, draft, projects = [] } = post.data;
// The `art` slot holds per-post art (ADR 0027); without it the header has no figure. Search
// skips it: the ascii kind is text.
const hasArt = Astro.slots.has('art');
---

<header class="post-header">
  <!-- A file bar over the post, as on a desktop: where it lives and how long it is. Decoration
       with real text, so search leaves it out. -->
  <p class="filebar" data-pagefind-ignore>
    <span>~/{folder}/{post.id}.md</span>
    {post.body !== undefined && <span>{readingMinutes(post.body)} min read</span>}
  </p>
  {hasArt && (
    <figure class="post-art" data-pagefind-ignore>
      <slot name="art" />
    </figure>
  )}
  <h1>{title}</h1>
  {draft && (
    <p>
      <strong>Draft:</strong> not published yet.
    </p>
  )}
  <div class="post-meta">
    <p>
      Published <time datetime={isoDay(date)}>{isoDay(date)}</time>
      {updated && (
        <>
          , last updated <time datetime={isoDay(updated)}>{isoDay(updated)}</time>
        </>
      )}
    </p>
    {tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {tags.map((tag) => (
          <li>{linkTags ? <a href={tagPath(tag)}>{tag}</a> : <span>{tag}</span>}</li>
        ))}
      </ul>
    )}
    {projects.length > 0 && (
      <ul class="post-projects" aria-label="Projects">
        {projects.map((slug) => (
          <li>
            <a href={projectPath(slug)} data-pagefind-filter="project">
              {slug}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</header>
