---
import { type ShippingStrip, stripWords } from '../data/format.ts';
import HeatDay from './HeatDay.astro';

interface Props {
  /** From `shippingStrip` (src/data/format.ts): drawn once, with the page (ADR 0038). */
  strip: ShippingStrip;
}

const { strip } = Astro.props;
const words = stripWords(strip);
---

<figure class="heat ship-heat">
  {/* A list of the days, oldest first. */}
  <ol class="heat-cells" aria-label={words.label}>
    {strip.cells.map((cell) => <HeatDay cell={cell} />)}
  </ol>
  <figcaption class="heat-cap">
    <span>{words.squares}</span>
    <span>{words.counted}</span>
  </figcaption>
</figure>
