---
import { notePath } from '../lib/til.ts';
import type { TilFrontmatter } from '../lib/til-schema.ts';
import { isoDay, tagPath } from '../lib/writing.ts';

interface Props {
  id: string;
  data: TilFrontmatter;
  /** The note's first paragraph (`noteSummary`); left out when it is only the title again. */
  summary: string;
  minutes: number;
  /** The title's level: 2 on /til, 3 under a tag page's "Notes" heading. */
  level?: 2 | 3;
}

const { id, data, summary, minutes, level = 2 } = Astro.props;
const { title, date, tags, draft } = data;
const Heading = level === 3 ? 'h3' : 'h2';
---

<article class="til-note">
  <Heading><a href={notePath(id)}>{title}</a></Heading>
  <div class="post-meta">
    <p>
      <time datetime={isoDay(date)}>{isoDay(date)}</time>{' '}
      {draft && <strong>Draft</strong>}
    </p>
    <p>{minutes} min read</p>
    {tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {tags.map((tag) => (
          <li>
            <a href={tagPath(tag)}>{tag}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
  {summary !== title && <p class="til-summary">{summary}</p>}
</article>
