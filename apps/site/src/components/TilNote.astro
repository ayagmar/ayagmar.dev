---
import { notePath } from '../lib/til.ts';
import type { TilFrontmatter } from '../lib/til-schema.ts';
import { isoDay } from '../lib/writing.ts';

interface Props {
  id: string;
  data: TilFrontmatter;
}

const { id, data } = Astro.props;
const { title, date, tags, draft } = data;
---

<article class="til-note">
  <h2><a href={notePath(id)}>{title}</a></h2>
  <div class="post-meta">
    <p>
      <time datetime={isoDay(date)}>{isoDay(date)}</time>{' '}
      {draft && <strong>Draft</strong>}
    </p>
    {tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {tags.map((tag) => (
          <li>
            <span>{tag}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
  <div class="prose">
    <slot />
  </div>
</article>
