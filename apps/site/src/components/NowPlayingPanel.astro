---
import { type Envelope, type ListeningSnapshot, staleAfterSeconds } from '@min7/contracts';
import { signalsApiBase, signalsMode } from '../data/signals.ts';
import NowPlaying from './NowPlaying.svelte';

interface Props {
  listening: Envelope<ListeningSnapshot, 'listening'>;
}

const { listening } = Astro.props;
const nowPlaying = listening.data?.nowPlaying ?? null;
---

<NowPlaying
  client:visible
  initial={nowPlaying === null
    ? null
    : { track: nowPlaying.track, artist: nowPlaying.artist, url: nowPlaying.url }}
  asOf={listening.data === null ? null : listening.fetchedAt}
  endpoint={signalsMode === 'api' ? `${signalsApiBase}/v1/listening` : null}
  liveForMs={staleAfterSeconds.listening * 1000}
/>
