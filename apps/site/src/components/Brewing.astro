---
import type { BrewingItem } from '../lib/now-schema.ts';
import { brewingHref, brewingTitle } from '../lib/plaintext.ts';

interface Props {
  items: readonly BrewingItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="panel m-cork" aria-labelledby="brewing">
    <h2 id="brewing">{brewingTitle}</h2>
    <ul class="brewing">
      {items.map((item) => {
        const href = brewingHref(item);
        return (
          <li>
            <strong>{href === undefined ? item.name : <a href={href}>{item.name}</a>}</strong>{' '}
            <span>{item.note}</span>
          </li>
        );
      })}
    </ul>
  </section>
)}
