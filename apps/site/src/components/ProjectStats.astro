---
import type { Envelope } from '@min7/contracts';
import { liveAttrs } from '../data/signals.ts';
import { projectStats } from '../lib/project-panel.ts';
import type { SiteProject } from '../lib/projects.ts';
import Freshness from './Freshness.astro';
import Markup from './Markup.astro';

interface Props {
  project: SiteProject;
  /** The projects envelope the build read, for the freshness line and the live script. */
  envelope: Envelope<unknown>;
}

const { project, envelope } = Astro.props;
---

{/* A project signals fetches is kept current from /v1/projects (src/scripts/project-live.ts);
    one with `pull: false` has nothing to ask for. */}
<div
  class="project-numbers"
  data-project={project.slug}
  data-pagefind-ignore
  {...project.pulled ? liveAttrs('projects', envelope) : {}}
>
  <div class="project-numbers-body">
    <Markup nodes={projectStats(project, project.live)} />
  </div>
  {project.pulled && <Freshness envelope={envelope} />}
</div>

<script>
import '../scripts/project-live.ts';
</script>
