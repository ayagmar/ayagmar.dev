---
import { projectFacts } from '../data/format.ts';
import { noNumbers, type SiteProject } from '../lib/projects.ts';

interface Props {
  project: SiteProject;
}

const { project } = Astro.props;
const facts = projectFacts(project);
---

{facts.length > 0 ? (
  <dl class="project-stats">
    {facts.map((fact) => (
      <>
        <dt>{fact.label}</dt>
        <dd>
          {'release' in fact && fact.release !== undefined ? (
            <>
              <a href={fact.release.url}>{fact.release.tag}</a>,{' '}
              <time datetime={fact.release.publishedAt}>{fact.release.day}</time>
            </>
          ) : (
            fact.value
          )}
        </dd>
      </>
    ))}
  </dl>
) : (
  <p class="project-stats-empty">{noNumbers(project)}</p>
)}
