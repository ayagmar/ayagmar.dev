---
import { isoDay, type Post, postPath } from '../lib/writing.ts';

interface Props {
  posts: readonly Post[];
}

const { posts } = Astro.props;
---

{posts.length === 0 ? (
  <p>Nothing published yet.</p>
) : (
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <time datetime={isoDay(post.data.date)}>{isoDay(post.data.date)}</time>
        <a href={postPath(post.id)}>{post.data.title}</a>
        {post.data.draft && <strong>Draft</strong>}
        <p>{post.data.summary}</p>
      </li>
    ))}
  </ul>
)}
