---
import { rabatTime } from '../data/format.ts';

interface Props {
  /** An RFC 3339 instant. */
  iso: string;
}

const { iso } = Astro.props;
---

<!-- Without JavaScript the time in Rabat; src/lib/live.ts rewrites it relative to now, with
     the exact time in the reader's own zone as its title (ADR 0015). -->
<time datetime={iso} data-ago title="Rabat time">{rabatTime(iso)}</time>
