---
import type { ShippingEvent } from '@min7/contracts';
import { describeEvent, repoName } from '../data/format.ts';
import Stamp from './Stamp.astro';

interface Props {
  events: readonly ShippingEvent[];
}

const { events } = Astro.props;
---

<!-- /stats renders the same list from a live answer (src/scripts/stats-live.ts). -->
<ul class="shipping">
  {events.map((event) => (
    <li>
      <Stamp iso={event.at} /> {repoName(event.repo)}{' '}
      {'url' in event ? <a href={event.url}>{describeEvent(event)}</a> : describeEvent(event)}
    </li>
  ))}
</ul>
