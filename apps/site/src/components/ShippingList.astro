---
import type { ShippingEvent } from '@min7/contracts';
import { shippingList } from '../lib/stats-panels.ts';
import Markup from './Markup.astro';

interface Props {
  events: readonly ShippingEvent[];
}

const { events } = Astro.props;
---

<!-- /stats renders the same list from a live answer (src/lib/stats-panels.ts). -->
<Markup nodes={shippingList(events)} />
