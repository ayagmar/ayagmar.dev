---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  /** The full-size image the viewer opens. */
  image: ImageMetadata;
  /** One sentence on what is on screen: the viewer's caption. */
  alt: string;
}

const { image, alt, ...attrs } = Astro.props;
// The viewer's sizes, never wider than the source. They are only in data attributes, so the page
// downloads one only when the viewer opens it, and the budgets do not count them (ADR 0049).
const widths = [...new Set([1344, 2048, image.width].filter((width) => width <= image.width))];
const large = await getImage({ src: image, widths, format: 'webp', quality: 80 });
---

{/* Without scripts a plain link to the file; src/scripts/image-viewer.ts opens it in place. */}
{/* biome-ignore lint/a11y/useAnchorContent: the content is the slot, an image with alt text or a link with aria-label, which the e2e axe checks see. */}
<a
  {...attrs}
  href={image.src}
  data-view
  data-view-srcset={large.srcSet.attribute}
  data-view-width={image.width}
  data-view-height={image.height}
  data-view-alt={alt}
>
  <slot />
</a>
