{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The CPU bench Worker (bench/worker.ts, `just signals-cpu`). Local only: never deployed.
  "name": "min7-signals-bench",
  "main": "worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // An obviously fake key: the bench answers Last.fm from memory.
  "vars": { "COMMIT_SHA": "bench", "LASTFM_API_KEY": "bench-fake-lastfm-key" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "min7-signals-bench",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "../migrations"
    }
  ]
}
