// Only for applying D1 migrations to the shared preview database:
//   wrangler d1 migrations apply DB --remote --config wrangler.preview-migrations.jsonc
// database_name and database_id must match previews.d1_databases in wrangler.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "min7-signals",
  "compatibility_date": "2026-10-26",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "min7-signals-preview",
      // PLACEHOLDER: same id as previews.d1_databases in wrangler.jsonc.
      "database_id": "5875597f-8d9c-4f35-a522-79efec2caf58",
      "migrations_dir": "migrations"
    }
  ]
}
