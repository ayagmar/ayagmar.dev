{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "min7-signals",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "upload_source_maps": true,
  // Previews inherit this block.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  // Created on deploy. The ayagmar.dev zone must be on the same Cloudflare account.
  "routes": [{ "pattern": "api.ayagmar.dev", "custom_domain": true }],
  // Pull adapters run from this one trigger; each adapter keeps its own interval (ADR 0010).
  // Cron Triggers never run for Previews.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Overridden on every deploy with the commit SHA (see the signals-* recipes in the justfile).
    "COMMIT_SHA": "dev"
  },
  // Set with `just signals-secrets`. Deploys fail while one is missing. The *_NEXT slots hold
  // the next value during a rotation and a random unused value otherwise (docs/operations.md).
  // GITHUB_TOKEN is optional (ADR 0009), so it is not listed; set it with `just signals-secret`.
  "secrets": {
    "required": [
      "LASTFM_API_KEY",
      "PUSH_TOKEN_LLM_USAGE",
      "PUSH_TOKEN_LLM_USAGE_NEXT",
      "PUSH_TOKEN_TRELLIS",
      "PUSH_TOKEN_TRELLIS_NEXT",
      "PUSH_HMAC_TRELLIS",
      "PUSH_HMAC_TRELLIS_NEXT"
    ]
  },
  // Best-effort push limit per producer and Cloudflare location (ADR 0011). The hard ceiling
  // is the minimum interval enforced in D1.
  "ratelimits": [
    { "name": "PUSH_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "min7-signals",
      // PLACEHOLDER: set to the id printed by `wrangler d1 create min7-signals` before the first deploy.
      "database_id": "3edbea5c-6325-4489-978c-ce3a95c2ad9f",
      "migrations_dir": "migrations"
    }
  ],
  // `wrangler preview` (PR previews) never inherits production vars, secrets or bindings.
  // Every preview shares the min7-signals-preview database; its migrations are applied
  // with wrangler.preview-migrations.jsonc. Preview secrets live in the Preview base config:
  // random fakes set once with `just signals-preview-secrets`, never production values.
  "previews": {
    "vars": { "COMMIT_SHA": "preview" },
    "ratelimits": [
      { "name": "PUSH_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "min7-signals-preview",
        // PLACEHOLDER: set to the id printed by `wrangler d1 create min7-signals-preview`.
        "database_id": "5875597f-8d9c-4f35-a522-79efec2caf58",
        "migrations_dir": "migrations"
      }
    ]
  }
}
