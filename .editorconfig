root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[justfile]
indent_size = 4

# A map is a rectangle; its rows end in the spaces that keep them one width.
[*.art.txt]
trim_trailing_whitespace = false

[apps/site/src/art/*.txt]
trim_trailing_whitespace = false
