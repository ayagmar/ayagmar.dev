#!/usr/bin/env bash
# Blocks a commit whose staged changes contain a secret. Enable with `just hooks`.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; install it to commit (https://github.com/gitleaks/gitleaks)." >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner --verbose .
