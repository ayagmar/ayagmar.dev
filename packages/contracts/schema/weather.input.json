{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "const": "weather"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "fetchedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stale": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "weatherCode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "cloudCoverPercent": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "precipitationMm": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000
                },
                {
                  "type": "null"
                }
              ]
            },
            "windSpeedKmh": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "isDay": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "temperatureC": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 70
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "observedAt",
            "weatherCode",
            "cloudCoverPercent",
            "precipitationMm",
            "windSpeedKmh",
            "isDay",
            "temperatureC"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "source",
    "version",
    "fetchedAt",
    "stale",
    "data"
  ]
}
