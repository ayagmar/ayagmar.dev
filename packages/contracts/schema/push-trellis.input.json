{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "producer": {
      "type": "string",
      "const": "trellis"
    },
    "deliveryId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "booksFinished": {
          "type": "object",
          "properties": {
            "year": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "year",
            "count"
          ]
        },
        "inProgress": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "anime",
                  "manga",
                  "light-novel",
                  "book"
                ]
              },
              "progress": {
                "type": "object",
                "properties": {
                  "current": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "total": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "current",
                  "total"
                ]
              }
            },
            "required": [
              "title",
              "kind",
              "progress"
            ]
          }
        },
        "habits": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "habit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "streakDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 36600
              }
            },
            "required": [
              "habit",
              "streakDays"
            ]
          }
        }
      },
      "required": [
        "booksFinished",
        "inProgress",
        "habits"
      ]
    }
  },
  "required": [
    "producer",
    "deliveryId",
    "sentAt",
    "payload"
  ]
}
