{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "const": "shelf"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "fetchedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stale": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "booksFinished": {
              "type": "object",
              "properties": {
                "year": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "year",
                "count"
              ]
            },
            "inProgress": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "anime",
                      "manga",
                      "light-novel",
                      "book"
                    ]
                  },
                  "progress": {
                    "type": "object",
                    "properties": {
                      "current": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "total": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "current",
                      "total"
                    ]
                  }
                },
                "required": [
                  "title",
                  "kind",
                  "progress"
                ]
              }
            },
            "habits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "habit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "streakDays": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 36600
                  }
                },
                "required": [
                  "habit",
                  "streakDays"
                ]
              }
            }
          },
          "required": [
            "booksFinished",
            "inProgress",
            "habits"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "source",
    "version",
    "fetchedAt",
    "stale",
    "data"
  ]
}
