{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "const": "project-events"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "fetchedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stale": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "projects": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "repo": {
                    "type": "string",
                    "maxLength": 140,
                    "pattern": "^[A-Za-z0-9-]{1,39}\\/[A-Za-z0-9._-]{1,100}$"
                  },
                  "events": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "repo": {
                              "type": "string",
                              "maxLength": 140,
                              "pattern": "^[A-Za-z0-9-]{1,39}\\/[A-Za-z0-9._-]{1,100}$"
                            },
                            "at": {
                              "type": "string",
                              "format": "date-time",
                              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                            },
                            "type": {
                              "type": "string",
                              "const": "release"
                            },
                            "url": {
                              "type": "string",
                              "maxLength": 2048,
                              "pattern": "^https:\\/\\/github\\.com\\/[^\\s]*$"
                            },
                            "tag": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "repo",
                            "at",
                            "type",
                            "url",
                            "tag"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "repo": {
                              "type": "string",
                              "maxLength": 140,
                              "pattern": "^[A-Za-z0-9-]{1,39}\\/[A-Za-z0-9._-]{1,100}$"
                            },
                            "at": {
                              "type": "string",
                              "format": "date-time",
                              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                            },
                            "type": {
                              "type": "string",
                              "const": "merge"
                            },
                            "url": {
                              "type": "string",
                              "maxLength": 2048,
                              "pattern": "^https:\\/\\/github\\.com\\/[^\\s]*$"
                            },
                            "number": {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            },
                            "title": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "repo",
                            "at",
                            "type",
                            "url",
                            "number",
                            "title"
                          ]
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "slug",
                  "repo",
                  "events"
                ]
              }
            }
          },
          "required": [
            "projects"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "source",
    "version",
    "fetchedAt",
    "stale",
    "data"
  ]
}
