{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "since": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "days": {
      "minItems": 1,
      "maxItems": 400,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "pushes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "commits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "merges": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "releases": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "stars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "repos": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "repo": {
                  "type": "string",
                  "maxLength": 140,
                  "pattern": "^[A-Za-z0-9-]{1,39}\\/[A-Za-z0-9._-]{1,100}$"
                },
                "pushes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "commits": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "merges": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "releases": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "stars": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                }
              },
              "required": [
                "repo",
                "pushes",
                "commits",
                "merges",
                "releases",
                "stars"
              ]
            }
          },
          "reposTruncated": {
            "type": "boolean"
          }
        },
        "required": [
          "date",
          "pushes",
          "commits",
          "merges",
          "releases",
          "stars",
          "repos",
          "reposTruncated"
        ]
      }
    }
  },
  "required": [
    "generatedAt",
    "since",
    "complete",
    "days"
  ]
}
